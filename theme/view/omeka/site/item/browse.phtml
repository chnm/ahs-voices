<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$thumbnail = $this->plugin('thumbnail');
$this->htmlElement('body')->appendAttribute('class', 'item resource browse');

$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;

$query = $this->params()->fromQuery();
$itemSetShow = isset($itemSet);
if ($itemSetShow):
    $this->headLink()->appendStylesheet($this->assetUrl('css/resource-page-blocks.css', 'Omeka'));
    $this->htmlElement('body')->appendAttribute('class', 'item-set');
    $query['item_set_id'] = $itemSet->id();
endif;
?>

<?php if ($itemSetShow): ?>
<!-- Item Set context -->
<section class="subpage-hero">
    <div class="container">
        <div class="kicker"><?php echo $translate('Story'); ?></div>
        <h1><?php echo $escape($itemSet->displayTitle(null, $valueLang)); ?></h1>
        <?php $desc = $itemSet->displayDescription(null, $valueLang); ?>
        <?php if ($desc): ?>
        <p><?php echo $escape($desc); ?></p>
        <?php endif; ?>
    </div>
</section>
<?php else: ?>
<!-- Browse all -->
<section class="subpage-hero">
    <div class="container">
        <div class="kicker"><?php echo $translate('The Archive'); ?></div>
        <h1><?php echo $translate('Browse Interviews'); ?></h1>
    </div>
</section>
<?php endif; ?>

<?php if ($itemSetShow): ?>
<!-- Collection intro: thumbnail + abstract (hero keeps the description) -->
<?php
$abstract = $itemSet->value('dcterms:abstract', ['lang' => $valueLang]);
$setThumbImg = trim($this->partial('common/item-set-thumb', ['itemSet' => $itemSet, 'type' => 'large', 'alt' => $itemSet->displayTitle(null, $valueLang)]));
?>
<?php if ($setThumbImg || $abstract): ?>
<section class="section collection-intro-section">
    <div class="container">
        <div class="collection-intro">
            <?php if ($setThumbImg): ?>
            <div class="collection-intro-thumb">
                <?php echo $setThumbImg; ?>
            </div>
            <?php endif; ?>
            <?php if ($abstract): ?>
            <div class="collection-intro-body">
                <p><?php echo $escape($abstract); ?></p>
            </div>
            <?php endif; ?>
        </div>
    </div>
</section>
<?php endif; ?>
<?php endif; ?>

<section class="section">
    <div class="container">
        <?php echo $this->searchFilters(); ?>

        <?php
        // Build list of distinct contributing institutions for filter dropdown
        $institutions = [];
        $allItems = $this->api()->search('items', ['site_id' => $site->id(), 'per_page' => 500])->getContent();
        foreach ($allItems as $si) {
            $pub = $si->value('dcterms:publisher');
            if ($pub) {
                $institutions[(string) $pub] = true;
            }
        }
        ksort($institutions);
        $institutions = array_keys($institutions);
        // Detect current filter from Omeka property query params
        $currentInstitution = '';
        $propertyQuery = $this->params()->fromQuery('property', []);
        foreach ($propertyQuery as $pq) {
            if (isset($pq['property']) && $pq['property'] == '5' && isset($pq['text'])) {
                $currentInstitution = $pq['text'];
                break;
            }
        }
        ?>

        <div class="browse-controls">
            <?php echo $this->pagination(); ?>
            <div style="display: flex; gap: 8px; align-items: center;">
                <?php if (count($institutions) > 1): ?>
                <?php
                // Build base URL without property filter for "All" option
                $baseQuery = $this->params()->fromQuery();
                unset($baseQuery['property']);
                $browseUrl = $this->url('site/resource', ['controller' => 'item', 'action' => 'browse'], true);
                $allUrl = $browseUrl . ($baseQuery ? '?' . http_build_query($baseQuery) : '');
                ?>
                <select onchange="window.location = this.value;" aria-label="<?php echo $escape($translate('Filter by institution')); ?>">
                    <option value="<?php echo $escape($allUrl); ?>"><?php echo $translate('All institutions'); ?></option>
                    <?php foreach ($institutions as $inst):
                        $filterQuery = $baseQuery;
                        $filterQuery['property'][0] = ['property' => '5', 'type' => 'eq', 'text' => $inst];
                        $optUrl = $browseUrl . '?' . http_build_query($filterQuery);
                    ?>
                    <option value="<?php echo $escape($optUrl); ?>"<?php if ($currentInstitution === $inst) echo ' selected'; ?>><?php echo $escape($inst); ?></option>
                    <?php endforeach; ?>
                </select>
                <?php endif; ?>
                <?php echo $this->hyperlink($translate('Advanced search'), $this->url('site/resource', ['controller' => 'item', 'action' => 'search'], ['query' => $query], true), ['class' => 'advanced-search']); ?>
                <?php echo $this->browse()->renderSortSelector('items'); ?>
            </div>
        </div>

        <?php $this->trigger('view.browse.before'); ?>

        <?php foreach ($items as $item):
            $heading = $item->displayTitle(null, $valueLang);
            $body = $item->displayDescription(null, $valueLang);
            // Find first image media for thumbnail
            $imageMedia = null;
            foreach ($item->media() as $m) {
                $mType = $m->mediaType();
                if ($mType && strpos($mType, 'image') === 0 && $m->hasThumbnails()) {
                    $imageMedia = $m;
                    break;
                }
            }
        ?>
        <div class="result-row">
            <?php if ($imageMedia): ?>
            <a href="<?php echo $escape($item->siteUrl($site->slug())); ?>">
                <?php echo $thumbnail($imageMedia, 'square', ['class' => 'result-thumb']); ?>
            </a>
            <?php endif; ?>
            <div class="result-body">
                <h3><a href="<?php echo $escape($item->siteUrl($site->slug())); ?>"><?php echo $escape($heading); ?></a></h3>
                <div class="meta">
                    <?php
                    $parts = [];
                    $created = $item->value('dcterms:created', ['lang' => $valueLang]);
                    if ($created) $parts[] = 'Recorded ' . $escape($created);
                    $extent = $item->value('dcterms:extent', ['lang' => $valueLang]);
                    if ($extent) $parts[] = $escape($extent);
                    $spatial = $item->value('dcterms:spatial', ['lang' => $valueLang]);
                    if ($spatial) $parts[] = $escape($spatial);
                    echo implode(' · ', $parts);
                    ?>
                </div>
                <?php
                $lede = $item->value('dcterms:abstract', ['lang' => $valueLang]);
                $preview = $lede ?: $body;
                ?>
                <?php if ($preview): ?>
                <p><?php
                $previewStr = (string) $preview;
                $limit = $lede ? 400 : 500;
                echo $escape(mb_substr($previewStr, 0, $limit) . (mb_strlen($previewStr) > $limit ? '…' : ''));
                ?></p>
                <?php endif; ?>
                <?php
                $subjects = $item->value('dcterms:subject', ['all' => true, 'lang' => $valueLang]);
                if ($subjects && count($subjects)):
                ?>
                <div class="tag-list">
                    <?php foreach ($subjects as $subject): ?>
                    <span class="tag"><?php echo $escape($subject); ?></span>
                    <?php endforeach; ?>
                </div>
                <?php endif; ?>
            </div>
        </div>
        <?php endforeach; ?>

        <?php $this->trigger('view.browse.after'); ?>
        <?php echo $this->pagination(); ?>
    </div>
</section>
